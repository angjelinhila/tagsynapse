# Copy to .env and adjust. Every value is optional - with no .env at all the
# repo resolves to <repo>/faiss/{index,tagging} and a FAISS service on
# localhost:5000. See tagsynapse/config.py for what each knob does.

# Root of the data tree: <DATA_DIR>/index (corpora + .index files) and
# <DATA_DIR>/tagging (controlled vocab, KG, user tags, GNN outputs).
TAGSYNAPSE_DATA_DIR=./faiss

# Where retrieval/build_filtered_faiss.py finds the *_filtered_output.jsonl inputs.
# Point this at a TACC / cluster allocation when building there.
TAGSYNAPSE_RAW_JSONL_DIR=./faiss/raw

# Sentence-transformers encoder used everywhere (384-d MiniLM by default).
TAGSYNAPSE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# The Streamlit app calls the FAISS service here (docker-compose exposes 5000).
TAGSYNAPSE_FAISS_URL=http://127.0.0.1:5000/search

# Index the faiss-service container loads (path *inside* the container).
TAGSYNAPSE_FAISS_INDEX_PATH=/mnt/faiss_index/artificial_filtered_output_faiss.index

TAGSYNAPSE_SEED=42
